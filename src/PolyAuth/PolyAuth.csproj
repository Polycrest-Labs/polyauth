<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <RootNamespace>PolyAuth</RootNamespace>
    <AssemblyName>PolyAuth</AssemblyName>
    <PackageId>PolyAuth</PackageId>
    <Version>0.3.0</Version>
    <Authors>PolyAuth</Authors>
    <Description>Reusable Firebase login + OAuth 2.1 Authorization Server + MCP authorization for .NET 10 apps.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>authentication;authorization;oauth;oauth2;openiddict;firebase;mcp;aspnetcore;dotnet</PackageTags>
    <PackageReleaseNotes>Upgrades the official C# MCP SDK to 2.1.0 and explicitly enables stateless Streamable HTTP for the 2026-07-28 MCP protocol revision while retaining compatibility with legacy initialize-based clients. Stateless transport removes MCP session affinity and is suitable for horizontally scaled ASP.NET Core deployments.</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PolyAuth.Tests" />
    <InternalsVisibleTo Include="PolyAuth.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.9" />
    <PackageReference Include="OpenIddict.EntityFrameworkCore" Version="7.5.0" />
    <PackageReference Include="OpenIddict.Server.AspNetCore" Version="7.5.0" />
    <PackageReference Include="OpenIddict.Validation.AspNetCore" Version="7.5.0" />
    <PackageReference Include="OpenIddict.Validation.ServerIntegration" Version="7.5.0" />
    <PackageReference Include="OpenIddict.MongoDb" Version="7.5.0" />
    <PackageReference Include="MongoDB.Driver" Version="3.10.0" />
    <PackageReference Include="FirebaseAdmin" Version="3.6.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.1.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
